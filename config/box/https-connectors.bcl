                      "API"
                    ]
                    "note" = "The literal is a valid member of its restricted picklist."
                  }
                  "verified" = {
                    "evidence" = "None in this repository. The CLM predecessor created a real record through the same POST shape from a Form trigger and confirmed every mapped field on the Salesforce record; that proves the code path, not this variant."
                    "loansVariantRunLive" = false
                    "predecessorProvedCodePath" = true
                    "reVerifyBeforeActivation" = "Run the minimized three-input metadata request end to end against the target org before activation."
                  }
