# box-ui-elements@27 pins @box/activity-feed@^2.3.12, but activity-feed@2.4.2
# declares peer @box/user-selector@^3.0.0 while the tree resolves 2.2.23. The
# committed package-lock.json already encodes that resolution, so `npm ci`
# needs this to reproduce it instead of failing ERESOLVE on a clean machine.
legacy-peer-deps=true
