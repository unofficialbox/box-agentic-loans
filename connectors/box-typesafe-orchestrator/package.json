{
  "name": "box-typesafe-orchestrator",
  "version": "1.0.0",
  "description": "Intelligent orchestration layer for Box integrations using TypeSafe.ai",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "benchmark": "node benchmark.js",
    "benchmark:quick": "node benchmark.js --quick",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "box",
    "typesafe",
    "orchestration",
    "ai",
    "mcp",
    "salesforce"
  ],
  "author": "Box",
  "license": "MIT",
  "dependencies": {
    "typesafe-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
