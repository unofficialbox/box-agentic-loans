# Environment-bound values for the LOS demo. Every variable here is read by code.
# First time: cp .env.sample .env, then fill it in.
# Already have a .env? Don't copy over it. Run `python3 scripts/sync_env.py --write`
# to pick up new or removed variables without touching values you've set.
# Load before the one-time scripts:   set -a; source .env; set +a
# Never commit .env. Secrets go to the org encrypted and are never read back.
# Lines starting "# KEY=" are optional overrides; the value shown is the default.

# --- Salesforce ---------------------------------------------------------------
# CLI alias of the demo org (sf org login web --alias <alias>). Also in demo-environment.json.
# The React live-preview token plugin mints against this org.
LOS_ORG_ALIAS=<alias>

# --- Box platform app (Client Credentials Grant) -------------------------------
# Used once by los-salesforce-project/scripts/configure-los-box-credential.sh <alias>.
BOX_CLIENT_ID=<client id from the Box Developer Console>
BOX_CLIENT_SECRET=

# --- Box CCG subject and allowlist ---------------------------------------------
# Used once by los-salesforce-project/scripts/configure-los-box-settings.sh <alias>.
# Set BOX_USER_ID (token acts as that Box user) or BOX_ENTERPRISE_ID (service account); the user wins.
# apps/loan-agent also needs BOX_ENTERPRISE_ID, for the losDocument metadata scope.
BOX_USER_ID=<box users:get me --fields=id>
BOX_ENTERPRISE_ID=
# Comma-separated folder IDs the token endpoint may mint for: the workspace folder
# from config/runtime/bootstrap-state.json.
BOX_ALLOWED_FOLDER_IDS=<workspace folder id>

# --- Salesforce integration user for the Box Automate connector ----------------
# Used once by los-salesforce-project/scripts/configure-los-oauth.sh <alias>.
LOS_INTEGRATION_USERNAME=<unique username, e.g. los-integration@<your-domain>>
LOS_INTEGRATION_EMAIL=<inbox that receives the setup mail>
LOS_INTEGRATION_PROFILE="Minimum Access - API Only Integrations"

# --- React bundle, local live preview only (npm run dev:live) -------------------
# The deployed bundle needs none of this: on the site the loan and folder come from the URL.
# The workspace folder to preview and mint a token for (usually the one in BOX_ALLOWED_FOLDER_IDS).
VITE_BOX_FOLDER_ID=<workspace folder id>
# VITE_BOX_HOSTNAME=app.box.com

# --- Loan agent backend (apps/loan-agent): TypeSafe decides, no LLM -------------
# Key from https://console.typesafe.ai/settings/keys. Server-side only: never expose it as a VITE_ variable.
TYPESAFE_API_KEY=
# MCP endpoints (Streamable HTTP) and bearer tokens for the two connectors.
LOS_MCP_URL=
LOS_MCP_TOKEN=
BOX_MCP_URL=
BOX_MCP_TOKEN=
# Commitment letter Doc Gen template (LOS_Box_Config__c.Commitment_Letter_Template_ID__c).
LOS_DOCGEN_TEMPLATE_FILE_ID=
# Signer used when a message names none. Leave empty to always ask.
LOS_DEFAULT_SIGNER_EMAIL=
LOS_DEFAULT_SIGNER_NAME=
# 1 = seeded Harborview fixtures instead of MCP (TypeSafe is still called).
LOAN_AGENT_FIXTURES=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_TIMEOUT_MS=30000
# Confidence thresholds (0.0 - 1.0); medium must be below high.
# TYPESAFE_HIGH_CONFIDENCE_THRESHOLD=0.85
# TYPESAFE_MEDIUM_CONFIDENCE_THRESHOLD=0.50
# LOAN_AGENT_PORT=8787
# LOAN_AGENT_ALLOWED_ORIGIN=http://localhost:3003

# --- Loan Copilot chat app (apps/agent-chat) -------------------------------------
# Base URL of the loan agent backend, e.g. http://localhost:8787 for apps/loan-agent.
# Leave empty to run the offline demo script. Vite ships this value to the browser.
VITE_AGENT_API_URL=
