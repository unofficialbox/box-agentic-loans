flowchart TD
    A["Manual: Confirm exact target environment\n(Box enterprise, Salesforce org)"]
    B["Run repo dry-run checks:\nstatus, doctor, bootstrap checks"]
    C["Generate fixtures and scenario selection"]
    D["Automated: Resolve\nscenario and runtime IDs from manifest"]
    E["Automated: Deploy portable Salesforce metadata\n(SFDX project metadata + React bundle)"]
    F["Automated: Seed deterministic Box foundation\n(metadata, fixtures, templates, tasks)"]
    G{"Manual confirmation\nof needed surfaces"}
    H["Manual: Authenticate to Box web app\nexact configured hostname"]
    I["Manual: Build/verify Credit Policy Hub content\nfrom the generated policy library"]
    J["Manual: Build/verify Apps workspace\nsections, views, charts, sharing"]
    K["Manual: Build/verify Hub layout, pinned policies, cadence"]
    L["Manual: Build/verify Automate workflows\noutcomes, connectors, variable bindings"]
    M["Store published IDs and URLs\ninto config/runtime/demo-environment.json"]
    N["Run end-to-end config validation\n(automated smoke + idempotency checks)"]
    O["Manual: Gatekeeping confirmations\nPublish / Share / Activate / Send / Sign"]
    P["Run rehearsed tell / show / tell\nscenario walkthrough"]
    Q["Capture and store operator evidence\nscreenshots, manifest, receipts"]

    A --> B --> C --> D
    D --> E --> M
    D --> F --> G
    G --> H
    H --> I
    I --> J --> K --> L --> M
    M --> N
    N --> O
    O --> P
    P --> Q

    classDef manual fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d,stroke-width:2px
    classDef automated fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef gate fill:#fef3c7,stroke:#b45309,color:#7c2d12

    class A,H,I,J,K,L,O manual
    class B,C,D,E,F,M,N,P,Q automated
    class G gate
